# SN64 board-top feasibility constraints (NOT the SN64 pinout: the FPGA sheet of
# the schematic does not exist yet). Pins are borrowed from the ULX3S, which uses
# the same LFE5U-85F CABGA381 package.
FREQUENCY PORT "osc_25" 25 MHZ;
FREQUENCY PORT "si_clk0" 21.477272 MHZ;
FREQUENCY PORT "si_clk1" 21.28137 MHZ;
# SNES master after the DCSC: the faster (NTSC) of the two selectable clocks.
FREQUENCY NET "clk_snes" 21.477272 MHZ;
# ULX3S 25 MHz oscillator input (a primary-clock-capable pin).
LOCATE COMP "osc_25" SITE "G2";
IOBUF PORT "osc_25" IO_TYPE=LVCMOS33;
# Configuration flash as user I/O after configuration (ULX3S sites; MCLK U3 is
# driven through USRMCLK, so it has no user port).
LOCATE COMP "flash_cs_n" SITE "R2";
LOCATE COMP "flash_dq[0]" SITE "W2";
LOCATE COMP "flash_dq[1]" SITE "V2";
LOCATE COMP "flash_dq[2]" SITE "Y2";
LOCATE COMP "flash_dq[3]" SITE "W1";
IOBUF PORT "flash_cs_n" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_dq[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_dq[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_dq[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_dq[3]" IO_TYPE=LVCMOS33;
