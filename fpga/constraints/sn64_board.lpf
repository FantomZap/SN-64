# SN64 board pin constraints for sn64_board_top (LFE5U-85F, CABGA381).
# GENERATED by hardware/sn64/tools/add_fpga_sheet.py from the same pin table as
# hardware/sn64/fpga.kicad_sch and hardware/sn64/interfaces/fpga-pin-map.csv;
# checked by hardware/sn64/tools/verify_fpga_sheet.py. Do not edit by hand.
# Port names follow sn64_board_top AFTER the integration edit listed in
# docs/design/fpga-schematic.md (cart_data inout, si_scl/si_sda open drain,
# cart_reset_pull_n, expand_sense, n64_si_dq, n64_int_n, adc_*). No HDMI pins since rev 0.5-fpga.
# Every bank VCCIO = 3.3 V (FPGA_3V3). Balls: Lattice ECP5U-85 pinout CSV rev 1.0.
# DRAFT: schematic-level pinout, no PCB escape routing or SI review yet.
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON;
FREQUENCY PORT "osc_25" 25 MHZ;
FREQUENCY PORT "si_clk0" 21.477272 MHZ;
FREQUENCY PORT "si_clk1" 21.28137 MHZ;
FREQUENCY NET "clk_snes" 21.477272 MHZ;
# --- n64 ---
